APP_ENV=deploy
NODE_ENV=production
LOG_LEVEL=info

NEXT_PUBLIC_API_BASE_URL=http://backend:8000

# ======================================================================
# LLM 配置 — 切换模型只需修改 LLM_PROVIDER 和对应的 Key
# 支持: minimax / openai / deepseek / qwen / zhipu / moonshot / custom
# ======================================================================
LLM_PROVIDER=minimax

# MiniMax（默认）
MINIMAX_API_KEY=sk-cp-Pj4-okk9TRAwKXckNZ5Ra1dP3y6RwZvT1slZOI3iDmARlwhGcVSIuAnSszK-2ZxQT5Pp6eYtqiyOE83ny2MV4jAtluGdKoqo3Dg4x0CGRaAKRqVjQWYLVlM
MINIMAX_API_BASE=https://api.minimaxi.com/v1

# OpenAI（取消注释并填入 Key 即可切换）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_API_BASE=https://api.openai.com/v1

# DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace_me
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 通义千问
# LLM_PROVIDER=qwen
# QWEN_API_KEY=replace_me
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：覆盖默认模型名（不设则用 provider 默认值）
# LLM_MODEL=

# ======================================================================
# 搜索
# ======================================================================
SEARCH_API_KEY=replace_me

# ======================================================================
# 数据库
# ======================================================================
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password
DATABASE_URL=postgresql://agent:agent_password@postgres:5432/agent
REDIS_URL=redis://redis:6379/0

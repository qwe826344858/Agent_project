APP_ENV=deploy
NODE_ENV=production
LOG_LEVEL=info

NEXT_PUBLIC_API_BASE_URL=http://localhost:34567
NEXT_PUBLIC_LEGACY_CHAT_URL=/api/chat
NEXT_PUBLIC_AGENT_CHAT_URL=/api/agent/chat
NEXT_PUBLIC_DEEP_AGENT_CHAT_URL=/api/agent/deep-chat
NEXT_PUBLIC_RAG_AGENT_CHAT_URL=/chat/rag-agent
API_UPSTREAM=http://172.17.0.1:34567

# ======================================================================
# LLM 配置 — 切换模型只需修改 LLM_PROVIDER 和对应的 Key
# 支持: minimax / openai / deepseek / qwen / zhipu / moonshot / custom
# ======================================================================
LLM_PROVIDER=minimax

# MiniMax（默认）
MINIMAX_API_KEY=replace_me
MINIMAX_API_BASE=https://api.minimaxi.com/v1

# OpenAI（取消注释并填入 Key 即可切换）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_API_BASE=https://api.openai.com/v1

# DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace_me
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 通义千问
# LLM_PROVIDER=qwen
# QWEN_API_KEY=replace_me
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：覆盖默认模型名（不设则用 provider 默认值）
# LLM_MODEL=

# ======================================================================
# 搜索
# ======================================================================
SEARCH_API_KEY=

# ======================================================================
# 数据库
# ======================================================================
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password
DATABASE_URL=postgresql://agent:agent_password@postgres:5432/agent
REDIS_URL=redis://redis:6379/0

# ======================================================================
# RAG / Embedding
# 默认走 OpenAI 兼容 embeddings 接口；若不填 KEY/BASE，则回退到默认 LLM provider 的配置
# ======================================================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=16
INGEST_NAMESPACE=default
INGEST_CHUNK_SIZE=1200
INGEST_CHUNK_OVERLAP=200
INGEST_MIN_CN_CHARS=50
